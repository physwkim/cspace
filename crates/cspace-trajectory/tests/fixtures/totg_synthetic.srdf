<?xml version="1.0"?>
<!--
  Companion SRDF for totg_synthetic.urdf. `virtual_joint` is a `fixed`
  attach to `world`, matching the FIXED_BASE_SRDF precedent in
  crates/cspace-collision/src/parry.rs — this fixture only needs a
  parseable root, not a mobile base.
-->
<robot name="totg_synthetic">
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="base"/>

  <group name="planar_group">
    <joint name="planar_joint"/>
  </group>

  <group name="mixed_group">
    <joint name="mixed_prismatic_joint"/>
    <joint name="mixed_revolute_joint"/>
  </group>
</robot>
